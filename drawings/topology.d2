  style: {fill: "#e8f1fd"; stroke: "#2f6fd6"; border-radius: 8; font-size: 16}

  hq-users: "hq-users\n172.16.10.0/24\nWindows/Linux clients" {style: {fill: "#f8fafc"; stroke: "#9aa3af"; stroke-dash: 3}}
  hq-servers: "hq-servers\n172.16.20.0/24\nAD, DNS, file" {style: {fill: "#f8fafc"; stroke: "#9aa3af"; stroke-dash: 3}}
  hq-dmz: "hq-dmz\n172.16.30.0/24\nJuice Shop, published via NAT" {style: {fill: "#f8fafc"; stroke: "#9aa3af"; stroke-dash: 3}}
}
internet -> hq: "untrust"
scm -> hq: manages {style: {stroke: "#2f6fd6"; stroke-dash: 5}}

branch: {
  label: "Branch: SBX-BR-FW\nVM-Series · managed by SCM · PAN-OS 12.1\nnewer PAN-OS than HQ, on purpose"
