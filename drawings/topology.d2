  br-users: "br-users\n172.17.10.0/24\nbranch clients" {style: {fill: "#f8fafc"; stroke: "#9aa3af"; stroke-dash: 3}}
}
internet -> branch: "untrust"
scm -> branch: manages {style: {stroke: "#2f6fd6"; stroke-dash: 5}}

hq <-> branch: "IPsec (planned)" {style: {stroke: "#7c3aed"; stroke-dash: 2}}
