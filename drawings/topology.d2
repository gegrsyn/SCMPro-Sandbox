  label: "OT: SBX-OT-FW-A / SBX-OT-FW-B (planned)\nVM-Series · managed by Panorama\nHA pair\nPurdue-model segmentation\ninternet via HQ"
  style: {fill: "#fdf1e6"; stroke: "#d9822b"; border-radius: 8; font-size: 16}

  z0: "OT-DMZ (L3.5)\n172.18.35.0/24\nhistorian mirror, patching" {style: {fill: "#f8fafc"; stroke: "#9aa3af"; stroke-dash: 3}}
  z1: "Site Ops (L3)\n172.18.30.0/24\nengineering, jump host" {style: {fill: "#f8fafc"; stroke: "#9aa3af"; stroke-dash: 3}}
  z2: "Control (L2)\n172.18.20.0/24\nHMI, SCADA" {style: {fill: "#f8fafc"; stroke: "#9aa3af"; stroke-dash: 3}}
  z3: "Field (L1)\n172.18.10.0/24\nPLCs: Modbus, S7, DNP3" {style: {fill: "#f8fafc"; stroke: "#9aa3af"; stroke-dash: 3}}
