direction: right
classes: {
  fw-scm: {style: {fill: "#2f6fd6"; font-color: "#ffffff"; font-size: 17; bold: true; border-radius: 8}}
  fw-pano: {style: {fill: "#d9822b"; font-color: "#ffffff"; font-size: 17; bold: true; border-radius: 8}}
  zone-scm: {style: {fill: "#eef4fd"; stroke: "#2f6fd6"; border-radius: 6; font-size: 15}}
  zone-pano: {style: {fill: "#fef6ee"; stroke: "#d9822b"; border-radius: 6; font-size: 15}}
  host: {style: {fill: "#ffffff"; stroke: "#6b7280"; font-size: 13; border-radius: 4}}
  site-scm: {style: {fill: "#e8f1fd"; stroke: "#2f6fd6"; font-size: 14}}
  site-pano: {style: {fill: "#fdf1e6"; stroke: "#d9822b"; font-size: 14}}
  link: {style: {font-size: 13; font-color: "#374151"}}
  vpn: {style: {stroke: "#7c3aed"; stroke-dash: 3; font-size: 13}}
}


*.style.font-size: 26
(* -> *)[*].style.font-size: 22
key: |md
  **Blue:** managed by Strata Cloud Manager · **Orange:** managed by Panorama  
  Panorama is connected to SCM, so its policy shows there too
| {near: top-center; style.font-size: 22}
scm: "Strata Cloud Manager\n(cloud)" {shape: cloud; style: {fill: "#ffffff"; stroke: "#2f6fd6"; font-size: 26; bold: true}}
hq: "HQ\nSCM-HQ-FW-A\nSCM-HQ-FW-B" {class: site-scm}
scm -> hq: manages {class: link; style.stroke: "#2f6fd6"}
branch: "Branch\nSCM-BRANCH-FW" {class: site-scm}
scm -> branch: manages {class: link; style.stroke: "#2f6fd6"}
panorama: PANORAMA {class: fw-pano}
scm -> panorama: connected {class: link; style.stroke-dash: 3}
plant: "Plant\nPANO-PLANT-FW-A\nPANO-PLANT-FW-B" {class: site-pano}
panorama -> plant: manages {class: link; style.stroke: "#d9822b"}
foot: "CC BY 4.0 · the known-good state the sandbox can be restored to" {shape: text; near: bottom-center; style.font-size: 13}
